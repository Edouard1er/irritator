execute_process(COMMAND "${BEFORE}" RESULT_VARIABLE a OUTPUT_FILE "${OUT}/differential-before.txt" ERROR_VARIABLE ea)
execute_process(COMMAND "${AFTER}" RESULT_VARIABLE b OUTPUT_FILE "${OUT}/differential-after.txt" ERROR_VARIABLE eb)
if(NOT a EQUAL 0 OR NOT b EQUAL 0)
  message(FATAL_ERROR "Differential driver failed: before=${a} ${ea}; after=${b} ${eb}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${OUT}/differential-before.txt" "${OUT}/differential-after.txt" RESULT_VARIABLE difference)
if(NOT difference EQUAL 0)
  message(FATAL_ERROR "Historical and corrected physical traces differ (hexadecimal exact double output)")
endif()
message(STATUS "36 QSS cases x 2 instrumentations x 2 engines, exact historical y0/X(t) traces: PASS")
