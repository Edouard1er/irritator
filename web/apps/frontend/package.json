{
  "name": "irritator-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@xyflow/react": "12.12.0",
    "ajv": "8.17.1",
    "plotly.js-basic-dist-min": "4.1.2",
    "lucide-react": "^0.577.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/plotly.js": "^3.0.0",
    "typescript": "~5.9.3",
    "vitest": "5.0.5",
    "jsdom": "^27.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@playwright/test": "^1.56.0"
  }
}
