{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "model",
    "simulation"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        2
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "components",
        "connections",
        "observations",
        "definitions"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/definitions/component"
          }
        },
        "connections": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "$ref": "#/definitions/endpoint"
              },
              "to": {
                "$ref": "#/definitions/endpoint"
              }
            }
          }
        },
        "observations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component",
              "samplingInterval"
            ],
            "properties": {
              "component": {
                "$ref": "#/definitions/path"
              },
              "samplingInterval": {
                "type": "number",
                "minimum": 0.000001,
                "maximum": 1000000000
              }
            }
          }
        },
        "definitions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "inputs",
              "outputs",
              "components",
              "connections"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/id"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "inputs": {
                "$ref": "#/definitions/ports"
              },
              "outputs": {
                "$ref": "#/definitions/ports"
              },
              "components": {
                "type": "array",
                "maxItems": 128,
                "items": {
                  "$ref": "#/definitions/component"
                }
              },
              "connections": {
                "type": "array",
                "maxItems": 512,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "from",
                    "to"
                  ],
                  "properties": {
                    "from": {
                      "$ref": "#/definitions/endpoint"
                    },
                    "to": {
                      "$ref": "#/definitions/endpoint"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "number",
          "minimum": -1000000000,
          "maximum": 1000000000
        },
        "end": {
          "type": "number",
          "minimum": -1000000000,
          "maximum": 1000000000
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxComponents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "maxConnections": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "maxRunCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "maxPoints": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "maxInstances": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "port"
      ],
      "properties": {
        "component": {
          "anyOf": [
            {
              "$ref": "#/definitions/id"
            },
            {
              "enum": [
                "$input",
                "$output"
              ]
            }
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "parameters"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "parameters": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "type": "number",
            "minimum": -1000000000000,
            "maximum": 1000000000000
          }
        },
        "definition": {
          "$ref": "#/definitions/id"
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": {
              "enum": [
                "coupled"
              ]
            }
          },
          "required": [
            "definition"
          ],
          "additionalProperties": true
        },
        {
          "properties": {
            "type": {
              "not": {
                "enum": [
                  "coupled"
                ]
              }
            }
          },
          "not": {
            "required": [
              "definition"
            ]
          }
        }
      ]
    },
    "ports": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "port",
          "name"
        ],
        "properties": {
          "port": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "name": {
            "$ref": "#/definitions/id"
          }
        }
      }
    }
  }
}
