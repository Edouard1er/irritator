    {
      "type": "value_memory",
      "name": "Mémoire à la demande",
      "description": "Mémoire identifiée ; reset puis écritures puis lectures dans un même sac. La commande read utilise les champs identité et campagne.",
      "parameters": {
        "initial": {
          "type": "number",
          "minimum": -1000000000000,
          "maximum": 1000000000000,
          "default": 0,
          "description": ""
        },
        "emitOnWrite": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "Émettre aussi à chaque écriture.",
          "choices": [
            "Lecture seulement",
            "Lecture et écriture"
          ]
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "default": 128,
          "description": "Nombre maximal de valeurs identifiées et de campagnes conservées. Reset libère la mémoire."
        }
      },
      "required": [
        "initial",
        "emitOnWrite",
        "capacity"
      ],
      "inputs": [
        {
          "port": 0,
          "name": "write"
