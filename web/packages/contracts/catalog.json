          "port": 0,
          "name": "score"
        },
        {
          "port": 1,
          "name": "action"
        },
        {
          "port": 2,
          "name": "condition"
        },
        {
          "port": 3,
          "name": "end"
        },
        {
          "port": 4,
          "name": "reset"
        }
