          "port": 1,
          "name": "read"
        },
        {
          "port": 2,
          "name": "reset"
        }
      ],
      "outputs": [
        {
          "port": 0,
          "name": "value"
        },
        {
          "port": 1,
          "name": "missing"
        }
      ]
    },
    {
      "type": "event_operator",
      "name": "Calcul événementiel",
      "description": "Joint les valeurs par identité et campagne. Une valeur invalide produit invalid et est exclue du flux result. end attend toutes les lignes avant de transmettre leur nombre valide.",
      "parameters": {
        "operation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 21,
          "default": 0,
          "description": "Opération sur a et b.",
          "choices": [
            "Identité",
            "Addition",
            "Soustraction",
            "Multiplication",
            "Division sûre",
            "Minimum",
            "Maximum",
            "Supérieur",
            "Inférieur",
            "Égal",
            "Supérieur ou égal",
            "Inférieur ou égal",
            "Différent",
            "ET",
            "OU",
            "NON",
            "Valeur absolue",
            "Puissance",
            "Racine",
            "Logarithme",
            "Exponentielle",
            "Normalisation affine"
          ]
        },
        "left": {
          "type": "number",
          "minimum": -1000000000000,
          "maximum": 1000000000000,
          "default": 0,
          "description": "Valeur initiale de a ; borne basse en normalisation."
        },
        "right": {
          "type": "number",
          "minimum": -1000000000000,
          "maximum": 1000000000000,
          "default": 0,
          "description": "Valeur initiale de b ; borne haute en normalisation."
        },
        "epsilon": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000,
          "default": 0,
          "description": "Tolérance égalité et dénominateur nul."
        },
        "required": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 1,
          "description": "Masque des entrées obligatoires : 1=a, 2=b, 3=a et b."
        },
        "automatic": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1,
          "default": 1,
          "description": "Calcul après réception ou sur commande trigger.",
          "choices": [
            "Sur commande",
            "À réception"
          ]
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "default": 128,
          "description": "Nombre maximal de valeurs identifiées et de campagnes conservées. Reset libère la mémoire."
        }
      },
      "required": [
        "operation",
        "left",
        "right",
        "epsilon",
        "required",
        "automatic",
        "capacity"
      ],
      "inputs": [
        {
          "port": 0,
          "name": "a"
        },
        {
          "port": 1,
          "name": "b"
        },
        {
          "port": 2,
          "name": "trigger"
        },
        {
          "port": 3,
          "name": "end"
        },
        {
          "port": 4,
          "name": "reset"
        }
      ],
      "outputs": [
        {
          "port": 0,
          "name": "result"
        },
        {
          "port": 1,
          "name": "invalid"
        },
        {
          "port": 2,
          "name": "end"
        }
      ]
    },
    {
      "type": "candidate_filter",
      "name": "Filtre de candidats",
      "description": "Joint score, action et condition par identité. Transmet les candidats admissibles et le nombre retenu en fin de campagne.",
      "parameters": {
        "defaultAction": {
          "type": "number",
          "minimum": -1000000000000,
          "maximum": 1000000000000,
          "default": 0,
          "description": ""
        },
        "defaultCondition": {
          "type": "number",
          "minimum": -1000000000000,
          "maximum": 1000000000000,
          "default": 1,
          "description": ""
        },
        "required": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7,
          "default": 1,
          "description": "Masque obligatoire : 1=score, 2=action, 4=condition. Le score est obligatoire."
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "default": 128,
          "description": "Nombre maximal de valeurs identifiées et de campagnes conservées. Reset libère la mémoire."
