          "port": 2,
          "name": "end"
        },
        {
          "port": 3,
          "name": "rejected"
        }
      ]
    },
    {
      "type": "candidate_select",
      "name": "Sélection de candidat",
      "description": "Attend end et toutes les actions. Égalité : plus petite identité. Aucun candidat : selected=0 et action seulement si emitFallback=1. La sortie action est un scalaire DEVS [action,0,0].",
      "parameters": {
        "direction": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "Choix de l’extrémum.",
          "choices": [
            "Maximum",
            "Minimum"
          ]
        },
        "fallback": {
          "type": "number",
          "minimum": -1000000000000,
          "maximum": 1000000000000,
          "default": 0,
          "description": ""
        },
        "requireAction": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1,
          "default": 1,
          "description": "Attendre l’action associée à chaque score.",
          "choices": [
            "Action de repli",
            "Action associée"
          ]
        },
        "emitFallback": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1,
          "default": 1,
          "description": "Campagne vide : supprimer l’action ou émettre le repli configuré. Défaut historique : 1.",
          "choices": ["Aucune action", "Émettre fallback"]
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "default": 128,
          "description": "Nombre maximal de valeurs identifiées et de campagnes conservées. Reset libère la mémoire."
        }
      },
      "required": [
        "direction",
        "fallback",
        "requireAction",
        "capacity"
      ],
      "inputs": [
        {
          "port": 0,
          "name": "score"
        },
        {
          "port": 1,
          "name": "action"
        },
        {
          "port": 2,
          "name": "end"
        },
        {
          "port": 3,
          "name": "reset"
        }
      ],
      "outputs": [
        {
          "port": 0,
          "name": "action"
        },
        {
          "port": 1,
          "name": "identity"
        },
        {
          "port": 2,
          "name": "score"
        },
        {
          "port": 3,
          "name": "selected"
        }
