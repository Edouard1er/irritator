PORT=3001
IRRITATOR_RUNNER=../build-web-test4/runner/irritator-runner.exe
API_BODY_LIMIT=1048576
ENGINE_TIMEOUT_MS=10000
ENGINE_MAX_CONCURRENT=2
ENGINE_MAX_STDOUT_BYTES=4194304
ENGINE_MAX_STDERR_BYTES=65536
ENGINE_MAX_COMPONENTS=128
ENGINE_MAX_CONNECTIONS=512
ENGINE_MAX_RUN_CALLS=100000
ENGINE_MAX_POINTS=20000
ENGINE_MAX_DEPTH=8
ENGINE_MAX_INSTANCES=512
